<?xml version="1.0" ?>
<robot name="harvesting_agribot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <xacro:property name="Blue" value="Gazebo/Blue" />
  <xacro:property name="Silver" value="Gazebo/Silver" />
  <xacro:property name="White" value="Gazebo/White" />
  <xacro:property name="Black" value="Gazebo/Black" />
  <xacro:property name="Grey" value="Gazebo/Grey" />
  
  <xacro:property name="prefix" value="harvesting_bot"/>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>${prefix}/Revolute_6</left_joint>
      <right_joint>${prefix}/Revolute_8</right_joint>

      <left_joint>${prefix}/Revolute_7</left_joint>
      <right_joint>${prefix}/Revolute_9</right_joint>

      <wheel_separation>0.259</wheel_separation>
      <wheel_separation>0.259</wheel_separation>

      <wheel_diameter>0.12</wheel_diameter>
      <wheel_diameter>0.12</wheel_diameter>

      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <odometry_frame>${prefix}/odom</odometry_frame>
      <robot_base_frame>${prefix}/base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>
  </gazebo>

<gazebo reference="${prefix}/base_link">
  <material>${White}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="${prefix}/front_left_wheel_1">
  <material>${Black}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="${prefix}/rear_left_wheel_1">
  <material>${Black}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="${prefix}/front_right_wheel_1">
  <material>${Black}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="${prefix}/rear_right_wheel_1">
  <material>${Black}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>


<gazebo reference="${prefix}_camera_link">
    <material>${Grey}</material>

    <sensor name="camera" type="depth">
        <pose> 0 0 0 0 0 0 </pose>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
            <horizontal_fov>1.089</horizontal_fov>
            <image>
                <format>B8G8R8</format>
                <width>640</width>
                <height>480</height>
            </image>
            <clip>
                <near>0.05</near>
                <far>12</far>
            </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>/${prefix}/camera/points:=/${prefix}/${prefix}_camera/depth/color/points</remapping>
              <remapping>/${prefix}/camera/camera_info:=/${prefix}/${prefix}_camera/color/camera_info</remapping>
              <remapping>/${prefix}/camera/depth/image_raw:=/${prefix}/${prefix}_camera/aligned_depth_to_color/image_raw</remapping>
              <remapping>/${prefix}/camera/image_raw:=/${prefix}/${prefix}_camera/color/image_raw</remapping>
              <remapping>/${prefix}/camera/depth/camera_info:=/${prefix}/${prefix}_camera/aligned_depth_to_color/camera_info</remapping>
            </ros>
            <update_rate>1.0</update_rate>
            <frame_name>${prefix}_camera_color_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>100.0</max_depth>
        </plugin>
    </sensor>
    </gazebo>
    <gazebo reference="link_1">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link_2">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link_3">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link_4">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link_5">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="right_gripper_link">
        <selfCollide>true</selfCollide>
        <material>Gazebo/White</material>
        <mu1>500.0</mu1>
        <mu2>200.0</mu2>
    </gazebo>
    <gazebo reference="left_gripper_link">
        <selfCollide>true</selfCollide>
        <material>Gazebo/White</material>
        <mu1>500.0</mu1>
        <mu2>200.0</mu2>
    </gazebo>
    <gazebo reference="braccio_base">
        <mu1>1</mu1>
        <mu2>1</mu2>
        <selfCollide>true</selfCollide>
        <material>Gazebo/Turquoise</material>
    </gazebo>
</robot>
